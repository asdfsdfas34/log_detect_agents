# OpenAI
OPENAI_API_KEY=sk-...
# Recommended: set an explicit model (examples: gpt-4.1-mini, gpt-4o-mini, etc.)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ChromaDB embeddings
# EMBEDDING_PROVIDER options: openai, azure_openai
# If EMBEDDING_PROVIDER=openai, OPENAI_EMBEDDING_API_KEY is required.
# If EMBEDDING_PROVIDER=azure_openai, AZURE_OPENAI_EMBEDDING_* values are required.
EMBEDDING_PROVIDER=openai

# OpenAI embeddings
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_BASE_URL=

# Azure OpenAI embeddings
# To use these values, set EMBEDDING_PROVIDER=azure_openai above.
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Embedding dimensions and batching
# OPENAI_EMBEDDING_DIMENSIONS can be used as a shared fallback.
# Pattern templates and case cards can be tuned independently.
OPENAI_EMBEDDING_DIMENSIONS=
OPENAI_PATTERN_EMBEDDING_DIMENSIONS=1024
OPENAI_CASE_CARD_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100

# Databases
POSTGRESQL_URL=postgresql://user:password@localhost:5432/app
CHROMADB_PATH=./.chroma
SQLITE_PATH=./data/logs.db

# App
LOG_LEVEL=INFO

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=log-detect-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
