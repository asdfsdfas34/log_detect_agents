# OpenAI
OPENAI_API_KEY=sk-...
# Recommended: set an explicit model (examples: gpt-4.1-mini, gpt-4o-mini, etc.)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Databases
POSTGRESQL_URL=postgresql://user:password@localhost:5432/app
CHROMADB_PATH=./.chroma
SQLITE_PATH=./data/logs.db

# App
LOG_LEVEL=INFO
LOG_LOOKBACK_DAYS=21

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=log-detect-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
