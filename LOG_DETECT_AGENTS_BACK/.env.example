# OpenAI
OPENAI_API_KEY=sk-...
# Recommended: set an explicit model (examples: gpt-4.1-mini, gpt-4o-mini, etc.)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ChromaDB embeddings
# EMBEDDING_PROVIDER options: openai, azure_openai
EMBEDDING_PROVIDER=openai

# OpenAI embeddings
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_BASE_URL=

# Azure OpenAI embeddings
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
OPENAI_PATTERN_EMBEDDING_DIMENSIONS=1024
OPENAI_CASE_CARD_EMBEDDING_DIMENSIONS=1536

# Databases
POSTGRESQL_URL=postgresql://user:password@localhost:5432/app
CHROMADB_PATH=./.chroma
SQLITE_PATH=./data/logs.db

# App
LOG_LEVEL=INFO

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=log-detect-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
